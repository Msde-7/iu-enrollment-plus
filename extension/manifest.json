{
  "manifest_version": 3,
  "name": "IU Stellic Plus",
  "version": "1.0.1",
  "description": "IU Bloomington grade distributions and RateMyProfessors ratings beside every course in Stellic.",
  "minimum_chrome_version": "111",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://stellic.iu.edu/*", "https://*.stellic.com/*"],
      "js": ["content/loader.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*.js", "lib/*.js", "ui/*"],
      "matches": ["https://stellic.iu.edu/*", "https://*.stellic.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "IU Stellic Plus"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://stellic.iu.edu/*", "https://*.stellic.com/*", "https://www.ratemyprofessors.com/*"]
}
